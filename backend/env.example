PORT=4000
CLIENT_ORIGIN=http://localhost:3000
JWT_SECRET=replace-with-a-long-random-secret

# --- Outgoing email (SMTP) — used for password reset + sign-up verification. ---
# This file is always loaded from backend/.env (even if you start the API from the repo root).
# If SMTP_HOST is empty: no real email is sent. In non-production, the API may return
# debugResetLink / debugVerificationLink for local testing. After changing .env, restart the API.
#
# How to get SMTP settings:
# - SendGrid, Brevo, Mailgun, Resend, Amazon SES: create an API key + SMTP user from their dashboard.
# - Google Workspace / Gmail: enable 2-Step Verification, then create an App Password (not your
#   normal password) and use smtp.gmail.com with that app password as SMTP_PASSWORD.
# - Microsoft 365: often smtp.office365.com, port 587, SMTP_SECURE=0, use your work email + password
#   (or app password if your org requires it).
#
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=0
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM="Elite Ethiopia <noreply@eliteethiopia.com>"
#
# PASSWORD_RESET_EXPIRY_MINUTES=60
# EMAIL_VERIFICATION_EXPIRY_MINUTES=1440
# Set to 1 only after SMTP works; blocks email/password login until users.verified is true (Google sign-in still verifies).
# REQUIRE_EMAIL_VERIFICATION_FOR_LOGIN=0

# Google sign-in (OAuth 2.0). Create credentials at https://console.cloud.google.com/apis/credentials
# Project ID: elite-ethiopia-service
# Application type: Web application. Authorized redirect URI must match exactly, e.g.:
#   http://localhost:4000/auth/google/callback
GOOGLE_CLIENT_ID=917511879176-aph8971q9mljkp0ufguj454jc65cvbrp.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=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
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback

# Single merged administrator account (super-admin role).
# Seeded only when the `users` table is empty on first API start.
# Legacy installs that had separate `founder@…` / `superadmin@…` rows are
# automatically migrated to this single email on startup.
ADMIN_EMAIL=admin@eliteethiopia.com
ADMIN_PASSWORD=EliteAdmin2026!

# --- Demo marketplace accounts (auto-seeded, idempotent) ---
# These accounts are created/refreshed on every API start by seedMarketplaceDemo.
# Each ships with a funded Elite wallet AND a mock Telebirr account (PIN 1234) so
# the full payment flow works out of the box.
#
# Shared password for every demo account: SeedUser2026!
#
# Freelancers:
#   freelancer1@eliteethiopia.com  Beba M.        Web dev
#   freelancer2@eliteethiopia.com  Hana T.        UI/UX design
#   freelancer3@eliteethiopia.com  Samuel K.      Digital marketing
#   freelancer4@eliteethiopia.com  Mahlet A.      Copywriting & Amharic translation
#   freelancer5@eliteethiopia.com  Yonas G.       Video editing & motion design
#
# Clients (each starts with a topped-up wallet so checkout works immediately):
#   client1@eliteethiopia.com      Demo Client       Retail
#   client2@eliteethiopia.com      Selamawit Bekele  Logistics
#   client3@eliteethiopia.com      Robel Hailu       Fintech
#
# Sellers (each has digital products in the catalog):
#   seller1@eliteethiopia.com      Mihret Studio       UI kits & brand packs
#   seller2@eliteethiopia.com      Dawit K.            Online courses
#   seller3@eliteethiopia.com      Bethel Audio Lab    Music & voice-over packs
#
# Mock Telebirr access: phone numbers are stored on each user's profile.
# Default PIN for every mock account: 1234. Use the Payments page to top up the
# Elite wallet, or pick "Telebirr" at checkout to pay directly.

# Admin password sync: in local dev (NODE_ENV not production) the admin password
# is re-hashed from this file on each API start. Set SYNC_SEED_ADMIN_PASSWORDS=0
# to turn that off. In production, set NODE_ENV=production (sync off unless
# SYNC_SEED_ADMIN_PASSWORDS=1).
# SYNC_SEED_ADMIN_PASSWORDS=0

# Create DB + tables first, e.g.:
#   cd backend && mysql -u root -p < database/elite_ethiopia.sql
#   mysql -u root -p < backend/database/elite_ethiopia.sql   (from project root)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=elite_ethiopia

# Full-course uploads are stored under backend/uploads/digital-products/ (created at startup).

# --- Public chatbot (Google Gemini) ---
# Get a key at https://aistudio.google.com/app/apikey (free tier is plenty for development).
# When unset, POST /api/chatbot/message returns 503 and the floating chat button on the
# public site shows a friendly "assistant unavailable" message instead of crashing.
# Persona + product facts live in backend/docs/elite-chatbot-prompt.md (edit without code changes).
# That prompt file is sent on each Gemini request; the long knowledge markdown/PDF are optional.
# Restart the API after changing .env or those files.
# GEMINI_API_KEY=   # Create your own at https://aistudio.google.com/app/apikey
# GEMINI_MODEL=gemini-2.0-flash-lite
# GEMINI_MODEL_FALLBACKS=gemini-2.0-flash,gemini-1.5-flash
# CHATBOT_PROMPT_MD=docs/elite-chatbot-prompt.md
# CHATBOT_INCLUDE_KNOWLEDGE_MD=0
# CHATBOT_KNOWLEDGE_MD=docs/elite-ethiopia-knowledge.md
# CHATBOT_KNOWLEDGE_PDF=docs/elite-ethiopia-knowledge.pdf
# CHATBOT_SUPPLEMENT_PDF=0
# CHATBOT_MAX_MESSAGE_CHARS=2000
# CHATBOT_RATE_LIMIT_PER_MINUTE=20
